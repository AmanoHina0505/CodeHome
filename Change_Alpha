public class ChangeAlpha : MonoBehaviour
{
    public Material material; // Assign your Liberation Sans SDF Material here in the Unity Editor

    void Start()
    {
        // Ensure the material is assigned
        if (material != null)
        {
            // Get the current color
            Color currentColor = material.color;

            // Set a new alpha value (e.g., 0.5 for half transparency)
            float newAlpha = 0f; // Change this value as needed

            // Assign the new color with the adjusted alpha
            material.color = new Color(currentColor.r, currentColor.g, currentColor.b, newAlpha);
        }
        else
        {
            Debug.LogError("Material not assigned!");
        }
    }
}
